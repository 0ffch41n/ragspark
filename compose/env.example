# RAGSpark settings. init-env.sh copies this file to .env, replacing
# @SECRET@ with random values and @TZ@ with the host time zone.
# .env holds passwords: it is created with mode 600 and never committed.

# ----------------------------------------------------------------- RAGSpark
# Which LLM runs: the base file plus one file from llm/.
COMPOSE_FILE=compose.yaml:llm/qwen-3.8-27b-nvfp4.yaml

# The only published port: RAGFlow's web interface and API.
RAGSPARK_HTTP_BIND=0.0.0.0
RAGSPARK_HTTP_PORT=80

# Model weights on the host, shared by all vLLM containers.
RAGSPARK_HF_CACHE=/srv/ragspark/hf-cache
# 1 = never contact Hugging Face at start-up: weights must already be in the cache.
RAGSPARK_HF_OFFLINE=1

# Time zone for all containers (RAGFlow's compose uses Asia/Shanghai).
RAGSPARK_TZ=@TZ@

# --------------------------------------------------------------- superuser
# Created on the first start only; changing these later has no effect.
DEFAULT_SUPERUSER_EMAIL=admin@ragspark.local
ADMIN_DEFAULT_PASSWORD=@SECRET@

# ----------------------------------------------------------------- secrets
# Signs login sessions (RAGFlow otherwise generates one and keeps it in Valkey).
RAGFLOW_SECRET_KEY=@SECRET64@
ELASTIC_PASSWORD=@SECRET@
MYSQL_PASSWORD=@SECRET@
MINIO_USER=rag_flow
MINIO_PASSWORD=@SECRET@
REDIS_PASSWORD=@SECRET@

# ------------------------------------------------------- RAGFlow (upstream)
# Names and values from RAGFlow 0.27.2's docker/.env unless noted.
DOC_ENGINE=elasticsearch
DB_TYPE=mysql
ES_HOST=es01
MEM_LIMIT=8073741824
MYSQL_HOST=mysql
MYSQL_DBNAME=rag_flow
MYSQL_PORT=3306
MYSQL_MAX_PACKET=1073741824
MINIO_HOST=minio
REDIS_HOST=redis
REDIS_PORT=6379
API_PROXY_SCHEME=python
ALLOW_ANY_HOST=0
# Sign-up is off (upstream: 1); new users are created by the superuser.
REGISTER_ENABLED=0
ENABLE_REGISTER=0
DISABLE_PASSWORD_LOGIN=false
USE_DOCLING=false
DOC_BULK_SIZE=4
EMBEDDING_BATCH_SIZE=16
RERANK_TOKEN_LIMIT_MODE=truncate
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
THREAD_POOL_MAX_WORKERS=128
WIKI_MAP_LLM_POOL_SIZE=20
WIKI_MAP_MAX_PENDING=25
WIKI_REFINE_WORKERS=4
WIKI_MAP_WORKERS=20
WIKI_MAP_TIMEOUT=600
WIKI_REDUCE_TIMEOUT=60
WIKI_PLAN_TIMEOUT=600
WIKI_REFINE_TIMEOUT=300
WIKI_MERGE_TIMEOUT=600
DOC_STRUCTURE_COMPILE_BATCH_CHUNKS=4
DOC_STRUCTURE_COMPILE_MAX_IN_FLIGHT=15
DOC_STRUCTURE_LLM_POOL_SIZE=20
STRUCTURE_CONTEXT_FRACTION=0.5
STRUCTURE_DEFAULT_CONTEXT=100000
KNOWLEDGE_GRAPH_CONTEXT_FRACTION=0.1
KNOWLEDGE_GRAPH_MIN_BATCH_TOKENS=2048
KNOWLEDGE_GRAPH_MAX_BATCH_TOKENS=4096
STRUCTURE_CHAIN_CORRECTION_TIMEOUT_S=120
LLM_POOL_RATE_LIMIT_RETRIES=3
LLM_POOL_RATE_LIMIT_RETRY_BASE_DELAY=1.0
LLM_POOL_RATE_LIMIT_RETRY_MAX_DELAY=30.0
